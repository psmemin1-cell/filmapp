# TMDB API v3 anahtarı (https://www.themoviedb.org/settings/api).
# v3 "API Key" veya v4 "API Read Access Token" (eyJ... ile başlar) kabul edilir.
TMDB_API_KEY=

# DoesTheDogDie API anahtarı (https://www.doesthedogdie.com/profile -> API).
# Free tier yalnızca ticari olmayan kullanım içindir.
DTDD_API_KEY=

# Movie-Map benzer film kaynağı (deneysel, varsayılan kapalı).
ENABLE_MOVIE_MAP=false

# Parents guide sağlayıcısı: scraper (yalnızca geliştirme) | dataset (lisanslı AWS veri seti)
PARENTS_GUIDE_PROVIDER=scraper
# dataset seçiliyse JSONL dökümünün yolu
PARENTS_GUIDE_DATASET_PATH=

# Tam (kayıpsız) yanıtların cache süresi: 6 saat.
CACHE_TTL_SECONDS=21600

# En az bir kaynağı "unavailable" olan yanıtların cache süresi: 5 dakika.
DEGRADED_CACHE_TTL_SECONDS=300

LOG_LEVEL=INFO

# Virgülle ayrılmış izinli origin listesi (web istemcisi yoksa boş bırakılabilir).
CORS_ALLOW_ORIGINS=*
